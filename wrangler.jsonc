{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Serwer MCP (Model Context Protocol) przypominamy.com — Streamable HTTP, bezstanowy.
  // Klient AI (Claude, Cursor, ChatGPT…) uwierzytelnia się kluczem API klienta (Bearer pk_…),
  // a narzędzia wołają bramkę przez service binding.
  "name": "przypominamy-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mcp.przypominamy.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "PUBLIC_BASE_URL": "https://api.przypominamy.com",
    "DOCS_URL": "https://przypominamy.com/mcp"
  },
  "services": [{ "binding": "API", "service": "przypominamy-api" }]
}
