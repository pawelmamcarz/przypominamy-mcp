{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pawelmamcarz/przypominamy",
  "title": "Przypominamy.com SMS",
  "description": "Polish SMS & voice gateway for AI agents: send SMS/TTS, pricing, buy credits, contacts, reports.",
  "websiteUrl": "https://przypominamy.com/mcp",
  "repository": {
    "url": "https://github.com/pawelmamcarz/przypominamy-mcp",
    "source": "github"
  },
  "version": "1.4.1",
  "icons": [
    {
      "src": "https://przypominamy.com/favicon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.przypominamy.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API key from https://app.przypominamy.com/keys>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
