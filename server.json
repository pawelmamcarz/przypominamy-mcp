{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pawelmamcarz/przypominamy",
  "title": "Przypominamy.com SMS",
  "description": "Polish SMS & voice gateway: send SMS/TTS, contacts, blacklist, tracked links, replies, reports.",
  "websiteUrl": "https://przypominamy.com/mcp",
  "repository": {
    "url": "https://github.com/pawelmamcarz/przypominamy-mcp",
    "source": "github"
  },
  "version": "1.2.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.przypominamy.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API key from https://app.przypominamy.com/keys>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
